# Copy to .env locally. Never commit your seed phrase.
SEED_PHRASE=""
# Only v4r2 and w5 (Wallet V5R1), workchain 0, standard wallet IDs (W5 subwallet 0).
WALLET_VERSION=w5
# Optional: mainnet (default) or testnet.
TON_NETWORK=mainnet
# Optional Toncenter API key; unauthenticated requests are throttled.
TONCENTER_API_KEY=
